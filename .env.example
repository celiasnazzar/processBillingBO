# Copiar este fichero como .env (no se sube a git) y rellenar los valores.
#   cp .env.example .env

# --- Base de datos cobro_proforma (consulta de email en v_consulta_email) ---
# Usuario cobro_n8n: solo SELECT en v_consulta_email y v_cobro_recordatorio_candidato
DB_HOST=192.168.1.239
DB_PORT=3306
DB_NAME=cobro_proforma
DB_USER=cobro_n8n
# Obligatoria para /correct-customer-email. Si va vacía, responde motivo=bd_no_disponible.
# Si contiene # o espacios, ponerla entre comillas simples.
DB_PASSWORD=
DB_CONNECT_TIMEOUT_S=10

# SSL con certificados de cliente (rutas a los ficheros; los mismos que usa cobro-gateway)
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
# Alternativa sin certificados (cifra pero no valida el servidor): DB_SSL=required
# Si se rellena alguna ruta de certificado, se usan los certificados y DB_SSL se ignora.
DB_SSL=
